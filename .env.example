# ─────────────────────────────────────────────────────────────────────────────
# Ahaara AI keys. Copy this file to `.env.local` and fill in the ones you have.
# You only need ONE provider. `.env.local` is git-ignored — never commit keys.
# On Vercel: Project → Settings → Environment Variables (same names).
# Keys are only read by the server code in /api; they never reach the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=
# ChatGPT — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Hugging Face — https://huggingface.co/settings/tokens (enable "Inference Providers")
HF_TOKEN=

# Which engine to use: auto | claude | openai | gemini | huggingface
AI_PROVIDER=auto
# Order tried in "auto" mode, and when one fails
AI_FALLBACK_ORDER=claude,openai,gemini,huggingface

# Optional model overrides (leave empty for the defaults)
# default: claude-opus-5-5   (cheaper: claude-haiku-5-5)
ANTHROPIC_MODEL=
# default: gpt-5.5
OPENAI_MODEL=
# default: gemini-flash-latest
GEMINI_MODEL=
# default: Qwen/Qwen3-32B
HF_MODEL=
# set a vision model to let Hugging Face read label photos
HF_VISION_MODEL=

# Protect your credits
# if set, only people who enter this code can use the AI
APP_ACCESS_CODE=
# questions per visitor per minute
RATE_LIMIT_PER_MINUTE=10
